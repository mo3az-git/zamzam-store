# LOCAL DEVELOPMENT ONLY. Replace these values locally; never use them in production.
POSTGRES_DB=zamzam_store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only-change-me
DATABASE_URL=postgres://postgres:local-dev-only-change-me@localhost:5432/zamzam_store
REDIS_URL=redis://localhost:6379
LOCKING_REDIS_URL=redis://localhost:6379
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
JWT_SECRET=local-development-only-jwt-secret-replace-before-use
COOKIE_SECRET=local-development-only-cookie-secret-replace-before-use
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Server-side same-origin cart BFF. Disabled until reviewed environment setup.
MEDUSA_BACKEND_URL=http://localhost:9000
ZAMZAM_STOREFRONT_ORIGIN=http://localhost:8000
ZAMZAM_CART_BFF_ENABLED=false
# Required on the Medusa backend: STORE_CORS must include ZAMZAM_STOREFRONT_ORIGIN.
# Checkout completion, shipping tariffs and payment gateways remain unconfigured.
