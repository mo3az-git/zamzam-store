{
  "name": "zamzam-store",
  "version": "0.1.0",
  "private": true,
  "description": "Arabic-first e-commerce platform for imported Zamzam water and dates in Egypt.",
  "engines": {
    "node": "24.22.x"
  },
  "workspaces": [
    "apps/backend",
    "apps/storefront"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build:backend && npm run build:storefront",
    "build:backend": "npm run build --workspace @zamzam/backend",
    "build:storefront": "npm run build --workspace @zamzam/storefront",
    "db:migrate": "npm run db:migrate --workspace @zamzam/backend",
    "spike:registry": "node scripts/verify-tp-registry.mjs",
    "spike:package-metadata": "node scripts/check-package-metadata.mjs",
    "spike:checks": "npm run spike:registry && npm run spike:package-metadata",
    "spike:medusa-loader": "node scripts/check-medusa-cli-tsconfig-paths.cjs",
    "spike:tp-readiness": "node scripts/assess-phase1-tp-readiness.mjs",
    "spike:target-validator": "node apps/backend/scripts/test-disposable-target-validator.mjs",
    "spike:tp02b-unit": "node apps/backend/scripts/check-tp02b-heartbeat-unit.mjs",
    "spike:tp02b": "node apps/backend/scripts/test-tp02b-lock-heartbeat.mjs",
    "spike:tp02c-unit": "node apps/backend/scripts/check-tp02c-cas-abort-unit.mjs",
    "spike:tp02c": "node apps/backend/scripts/test-tp02c-lock-timeout-cas-abort.mjs",
    "spike:tp03-negative-control": "node apps/backend/scripts/check-stage2-lock-negative-control.mjs",
    "spike:migration-rollback": "node apps/backend/scripts/test-migration-rollback-isolated.mjs"
  },
  "devDependencies": {
    "@swc/core": "^1.7.28",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@types/node": "^20.17.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.5.4",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "picomatch": "3.0.2",
    "tsconfig-paths": "4.2.0"
  }
}
