{
  "name": "zamzam-store",
  "version": "0.1.0",
  "private": true,
  "description": "Arabic-first e-commerce platform for imported Zamzam water and dates in Egypt.",
  "engines": { "node": "24.22.x" },
  "workspaces": ["apps/backend", "apps/storefront"],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build:backend && npm run build:storefront",
    "build:backend": "npm run build --workspace @zamzam/backend",
    "build:storefront": "npm run build --workspace @zamzam/storefront",
    "db:migrate": "npm run db:migrate --workspace @zamzam/backend",
    "spike:registry": "node scripts/verify-tp-registry.mjs",
    "spike:package-metadata": "node scripts/check-package-metadata.mjs",
    "spike:checks": "npm run spike:registry && npm run spike:package-metadata"
  },
  "devDependencies": {
    "@swc/core": "^1.7.28",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  }
}
