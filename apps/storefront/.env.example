[TEMPLATE]
# Medusa backend origin, e.g. http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable key of the sales channel that holds the public catalog.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Optional: pin the EGP region when the store has more than one.
# Leave empty to resolve the region whose currency is EGP from /store/regions.
MEDUSA_REGION_ID=

# Public origin of the deployed storefront, used for canonical/hreflang URLs.
# Local development falls back to http://localhost:8000.
NEXT_PUBLIC_SITE_URL=
